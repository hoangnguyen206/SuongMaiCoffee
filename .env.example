# Local Docker defaults only. Use separate values in Render.
APP_ENV=local
PORT=80
HOST_PORT=8080
DB_HOST=db
DB_PORT=5432
DB_NAME=khanh_catalog
DB_USER=khanh_catalog
DB_PASSWORD=replace_with_a_local_password
DB_SSLMODE=prefer
DB_CONNECT_TIMEOUT=5
AUTH_RATE_LIMIT_KEY=replace_with_a_long_random_key
SESSION_COOKIE_SECURE=0
APP_URL=http://127.0.0.1:8080
